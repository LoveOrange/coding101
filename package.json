{
  "name": "linsama",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "npm run check:doc-links && npm run check:review-resources && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "preview:local": "LOCAL_PREVIEW=true npm run build && docusaurus serve --host 127.0.0.1 --port 3000 --no-open",
    "check:doc-links": "node scripts/normalize-doc-links.mjs --check",
    "fix:doc-links": "node scripts/normalize-doc-links.mjs --write",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "check:review-resources": "node scripts/check-review-resources.mjs && node scripts/generate-campus-jobs.mjs --check && node scripts/generate-interview-research.mjs --check"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-google-gtag": "^3.10.2",
    "@docusaurus/plugin-ideal-image": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.4.4"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "remark-parse": "^11.0.0",
    "typescript": "~5.2.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
